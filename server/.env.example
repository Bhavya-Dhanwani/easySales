PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/easysales
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# JWT Authentication (min 32 chars; must be changed in production)
ACCESS_TOKEN_SECRET=dev_only_access_jwt_secret_change_in_production
REFRESH_TOKEN_SECRET=dev_only_refresh_jwt_secret_change_in_production

# SMTP / Mail Settings (SEND_MAIL=false logs mail instead of sending it)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDING_USER="easySales <noreply@example.com>"
SEND_MAIL=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# AI gateway — any OpenAI-compatible endpoint (LiteLLM, OpenAI, ...)
LLM_BASE_URL=https://litellm.vision.aivar.app/v1
LLM_API_KEY=
LLM_MODEL_SMART=claude-sonnet-4.6
LLM_MODEL_FAST=claude-haiku

# 32+ random chars; encrypts stored email credentials (required in production)
ENCRYPTION_KEY=dev_only_encryption_key_change_in_production_000

# Optional webhook (Slack/Discord compatible) for alerts: failed workflows, budget, send caps
ALERT_WEBHOOK_URL=

# Run the job worker inside the API process
RUN_WORKER=true

# Prototype previews (Sprint 4). Prefer a separate domain pointing at this server, e.g. https://preview.example.com
PREVIEW_BASE_URL=
