PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/easysales
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# JWT Authentication (min 32 chars; must be changed in production)
ACCESS_TOKEN_SECRET=dev_only_access_jwt_secret_change_in_production
REFRESH_TOKEN_SECRET=dev_only_refresh_jwt_secret_change_in_production

# SMTP / Mail Settings (SEND_MAIL=false logs mail instead of sending it)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDING_USER="easySales <noreply@example.com>"
SEND_MAIL=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# AI gateway — any OpenAI-compatible endpoint (LiteLLM, OpenAI, ...)
LLM_BASE_URL=https://litellm.vision.aivar.app/v1
LLM_API_KEY=
LLM_MODEL_SMART=claude-sonnet-4.6
LLM_MODEL_FAST=claude-haiku

# 32+ random chars; encrypts stored email credentials (required in production)
ENCRYPTION_KEY=dev_only_encryption_key_change_in_production_000

# Optional webhook (Slack/Discord compatible) for alerts: failed workflows, budget, send caps
ALERT_WEBHOOK_URL=

# Run the job worker inside the API process
RUN_WORKER=true

# Prototype previews (Sprint 4). Prefer a separate domain pointing at this server, e.g. https://preview.example.com
PREVIEW_BASE_URL=

# Sprint 5: metering, operators and backpressure
BILLING_CURRENCY=INR
LLM_COST_INPUT_PER_MTOK_MINOR=25000
LLM_COST_OUTPUT_PER_MTOK_MINOR=125000
EMAIL_COST_MINOR=0
GLOBAL_DAILY_SPEND_CAP_MINOR=0
ADMIN_EMAILS=
QUEUE_BACKPRESSURE=500
API_RATE_LIMIT_PER_MIN=300
TENANT_RATE_LIMIT_PER_MIN=600

# Sprint 7: billing webhook secret (from your billing provider integration) and read-only support staff
BILLING_WEBHOOK_SECRET=
SUPPORT_EMAILS=

# Sprint 8: integrations. Google Calendar reuses GOOGLE_CLIENT_ID/SECRET (add the redirect URI below to that OAuth client)
# Redirect URIs: <PUBLIC_API_URL>/api/integrations/oauth/hubspot/callback and .../google_calendar/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
PUBLIC_API_URL=
# private app token from a HubSpot developer TEST account, only for `npm run pilot:hubspot`
HUBSPOT_PILOT_TOKEN=

# Neatlogs AI tracing (https://neatlogs.com): set a project key to send traces; PII is redacted.
# NEATLOGS_CAPTURE_CONTENT=false sends timing, tokens and metadata only (no prompts or outputs).
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
NEATLOGS_CAPTURE_CONTENT=true

# Lead discovery on OpenStreetMap (free, no key); the public server allows low volume only
NOMINATIM_URL=https://nominatim.openstreetmap.org
DISCOVERY_SEARCHES_PER_DAY=30
# optional: Tavily web search alongside OpenStreetMap (free plan: 1,000 searches a month, no card)
TAVILY_API_KEY=

# Platform email through Brevo (https://app.brevo.com -> SMTP & API -> API keys).
# Workspaces that skip connecting their own mailbox send from PLATFORM_FROM_EMAIL (a verified Brevo sender),
# and sign-up / password emails go out through it too.
BREVO_API_KEY=
PLATFORM_FROM_EMAIL=
PLATFORM_FROM_NAME=easySales
# Replies to platform mail arrive here (e.g. a Gmail address + its app password, IMAP enabled)
PLATFORM_REPLY_EMAIL=
PLATFORM_REPLY_PASSWORD=

# Fallback AI provider (https://console.mistral.ai -> API keys): takes over when the LLM_* endpoint fails
MISTRAL_API_KEY=
MISTRAL_MODEL_SMART=ministral-14b-latest
MISTRAL_MODEL_FAST=ministral-8b-latest
