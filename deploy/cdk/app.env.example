# Copy to app.env (git-ignored) and fill in. deploy.mjs stores it in AWS Secrets Manager.
# The URL, database and secret keys are set by the stack; don't put them here.

# AI agents (required for any AI step)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_SMART=
LLM_MODEL_FAST=

# sign-up and password-reset emails (Gmail app password on 587 works)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDING_USER=
SEND_MAIL=true

# your email: Operations page access
ADMIN_EMAILS=

# optional
TAVILY_API_KEY=
NEATLOGS_API_KEY=
ALERT_WEBHOOK_URL=
DISCOVERY_SEARCHES_PER_DAY=30
