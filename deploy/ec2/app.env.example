# Copy to app.env (git-ignored) and fill in. deploy.mjs sends these to the server over SSH;
# they never go into EC2 user data. URLs, the database and secret keys are set on the server.

# required: your email (Operations access and the HTTPS certificate contact)
ADMIN_EMAILS=

# AI agents (required for any AI step)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_SMART=
LLM_MODEL_FAST=

# sign-up and password-reset emails (empty = codes are written to the server log)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDING_USER=
SEND_MAIL=

# optional
TAVILY_API_KEY=
NEATLOGS_API_KEY=
ALERT_WEBHOOK_URL=
